{
  "name": "fullstack-nestjs-template",
  "version": "2.10.0-rc.2",
  "main": "desktop/main.cjs",
  "private": true,
  "flags": {
    "supportBusinessUser": true,
    "supportScrollReveal": true,
    "customToaster": true
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:server": "cross-env NODE_ENV=development nest start --watch",
    "dev:client": "cross-env NODE_ENV=development MIAODA_APP_TYPE=3 vite --config vite.config.ts",
    "desktop": "electron desktop/main.cjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed.mjs",
    "gen:db-schema": "npx -y @lark-apaas/db-schema-sync@latest --output server/database/schema.ts --export-custom-types",
    "gen:openapi": "echo 'UNSUPPORTED, SKIP'",
    "build": "./scripts/build.sh",
    "build:prod": "npm run build:server && npm run build:client",
    "build:server": "cross-env NODE_ENV=production nest build",
    "build:client": "cross-env NODE_ENV=production vite build --config vite.config.ts",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "qa:desktop": "npm run build:prod && node scripts/qa-workspace.mjs",
    "qa:packaged": "node scripts/qa-packaged-smoke.mjs",
    "qa:personal": "node scripts/qa-personal-assist.cjs",
    "package:desktop": "electron-builder --win nsis",
    "start": "NODE_ENV=production node main.js",
    "eslint": "eslint . --quiet",
    "stylelint": "stylelint client/src/**/*.css --quiet",
    "type:check": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run type:check:server\" \"npm run type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json",
    "lint": "node ./scripts/lint.js",
    "precommit": "node scripts/hooks/run-precommit.js",
    "prepare": "chmod +x .githooks/pre-commit 2>/dev/null; git config core.hooksPath .githooks 2>/dev/null || true",
    "postinstall": "fullstack-cli action-plugin init"
  },
  "dependencies": {
    "@lark-apaas/fullstack-nestjs-core": "^1.1.64",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.44.6",
    "hbs": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@lark-apaas/client-toolkit": "^1.2.72",
    "@lark-apaas/coding-preset-vite-react": "^1.0.25",
    "@lark-apaas/fullstack-presets": "^1.1.25",
    "@nestjs/cli": "^10.4.9",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.16.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/hbs": "^4.0.5",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "0.31.11",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "eslint": "^9.35.0",
    "lucide-react": "0.577.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "stylelint": "^17.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript-eslint": "^8.44.0",
    "vite": "^8"
  },
  "overrides": {
    "dayjs": "^1.11.15",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "echarts": "^6.1.0",
    "stylelint": "^17.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "build": {
    "appId": "com.matrix.desktop",
    "productName": "矩效 Matrix",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app-runtime/dist"
      },
      {
        "from": "desktop/database-schema.sql",
        "to": "config/database-schema.sql"
      },
      {
        "from": "desktop/database-seed.sql",
        "to": "config/database-seed.sql"
      },
      {
        "from": ".desktop-runtime/postgres",
        "to": "postgres",
        "filter": [
          "bin/*.dll",
          "bin/postgres.exe",
          "bin/pg_ctl.exe",
          "bin/initdb.exe",
          "bin/createdb.exe",
          "bin/psql.exe",
          "bin/pg_dump.exe",
          "bin/pg_restore.exe",
          "lib/*.dll",
          "share/**/*",
          "server_license.txt"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Matrix-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "矩效 Matrix"
    }
  }
}
