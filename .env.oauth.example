# Production OAuth configuration. Copy these keys to .env.local; never commit real secrets.
APP_PUBLIC_URL=https://your-domain.example
OAUTH_CALLBACK_URL=https://your-domain.example/api/platform/oauth/callback
OAUTH_STATE_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# Douyin Open Platform website application
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_SCOPES=user_info
