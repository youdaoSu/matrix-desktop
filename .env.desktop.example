# Copy this file to %APPDATA%\矩效 Matrix\.env.local after installation.
NODE_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=3210
SUDA_DATABASE_URL=postgresql://matrix_user:change_me@127.0.0.1:5432/matrix_db
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_STATE_SECRET=replace-with-another-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-secret

# Douyin OAuth is enabled only after your app is approved and these values are configured.
# Other platforms remain unavailable until their official open-platform access is approved.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_SCOPES=user_info
# Use your approved public HTTPS domain, not a local desktop address.
APP_PUBLIC_URL=https://your-domain.example
OAUTH_CALLBACK_URL=https://your-domain.example/api/platform/oauth/callback
